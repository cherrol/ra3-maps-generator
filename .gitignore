__pycache__/
*.pyc

# Generated releases, caches and local research stay outside source control.
/assets/
/dist/
/work/
/target/
/archive/

# Track playable-map inputs and version archives. Current previews and raw geography stay ignored.
/maps/*
!/maps/.default
!/maps/*/
/maps/*/*
!/maps/*/config.json
!/maps/*/version.json
!/maps/*/layout.json
!/maps/*/layers.npz

# Version-scoped blueprints and source snapshots.
!/maps/*/histories/
/maps/*/histories/*
!/maps/*/histories/v[0-9]*/
/maps/*/histories/v[0-9]*/*
!/maps/*/histories/v[0-9]*/layers.npz
!/maps/*/histories/v[0-9]*/layout.json
!/maps/*/histories/v[0-9]*/ramps.json
!/maps/*/histories/v[0-9]*/preview*.png
!/maps/*/histories/legacy/
/maps/*/histories/legacy/*
!/maps/*/histories/legacy/layers.npz
!/maps/*/histories/[TV][0-9]*/
/maps/*/histories/[TV][0-9]*/*
!/maps/*/histories/[TV][0-9]*/*.json
!/maps/*/histories/[TV][0-9]*/*.npz
!/maps/*/histories/[TV][0-9]*/*.u16
!/maps/*/histories/[TV][0-9]*/*.u8
!/maps/*/histories/[TV][0-9]*/*.txt
!/maps/*/histories/[TV][0-9]*/source.zip
!/maps/陕西/histories/T0.5.1/\[CHAI\]叠岭连原T0.5.1--rebuild.zip
!/maps/*/coordinate-system.json

!/maps/*/authoring/
/maps/*/authoring/*
!/maps/*/authoring/source.zip
!/maps/*/authoring/layout.json
!/maps/*/authoring/baseline.json
!/maps/*/authoring/policy.json
!/maps/*/authoring/coordinate-id-map.json
!/maps/*/authoring/resource-distribution.json
